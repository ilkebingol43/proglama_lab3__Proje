@model Lab3_proje.Models.Entities.StajBasvuru

@{
    ViewData["Title"] = "Öğrenci Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ogrenci = ViewBag.Ogrenci as Lab3_proje.Models.Entities.User;
    bool tamamlandiMi = Model != null && Model.Statu.Equals("tamamlandi", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-4">

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Hata"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100">
                <h4 class="fw-bold text-dark border-bottom pb-3 mb-3">Öğrenci Bilgileri</h4>
                <div class="mb-3">
                    <small class="text-secondary d-block">Ad Soyad</small>
                    <span class="fs-5 fw-semibold text-dark">@(ogrenci?.Name ?? "-")</span>
                </div>
                <div class="mb-3">
                    <small class="text-secondary d-block">Kullanıcı Adı</small>
                    <span class="fs-5 fw-semibold text-dark">@(ogrenci?.OgrenciDetay?.OgrenciNo ?? ogrenci?.UserName ?? "-")</span>
                </div>
                <div class="mb-3">
                    <small class="text-secondary d-block">Bölüm</small>
                    <span class="fs-6 fw-semibold text-dark">@(ogrenci?.OgrenciDetay?.OkuduguBolum ?? "Belirtilmemiş")</span>
                </div>
                <div class="mb-3">
                    <small class="text-secondary d-block">E-posta</small>
                    <span class="fs-6 text-dark">@(ogrenci?.Email ?? "-")</span>
                </div>
                <div class="mt-auto pt-3 border-top">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100 rounded-3">Çıkış Yap</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <h4 class="fw-bold text-dark mb-0">Staj Başvuru Durumu</h4>
                    @if (!tamamlandiMi)
                    {
                        <a href="/Student/EvrakYukle" class="btn btn-success px-4 rounded-3" style="background-color: #10B981; border: none;">
                            Evrak Yükle
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-secondary p-2 px-3 rounded-pill fs-6">
                            Başvuru Tamamlandı (Düzenlenemez)
                        </span>
                    }
                </div>

                @if (Model == null)
                {
                    <div class="text-center py-5">
                        <div class="text-secondary mb-3 fs-5">Henüz sisteme yüklenmiş bir Ek-16 staj evrakınız bulunmamaktadır.</div>
                        <a href="/Student/EvrakYukle" class="btn btn-lg btn-success px-4 rounded-3" style="background-color: #10B981; border: none;">
                            Evrak Yükle
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Başvuru Durumu</small>
                                @if (Model.Statu == "yüklendi" || Model.Statu == "Yuklendi")
                                {
                                    <span class="badge bg-primary fs-6 mt-1">Yüklendi</span>
                                }
                                else if (Model.Statu == "inceleniyor" || Model.Statu == "Inceleniyor")
                                {
                                    <span class="badge bg-warning text-dark fs-6 mt-1">İnceleniyor</span>
                                }
                                else if (Model.Statu == "onaylandi" || Model.Statu == "Onaylandi")
                                {
                                    <span class="badge bg-success fs-6 mt-1">Onaylandı</span>
                                }
                                else if (Model.Statu == "hatali" || Model.Statu == "Hatali")
                                {
                                    <span class="badge bg-danger fs-6 mt-1">Hatalı / Eksik</span>
                                }
                                else if (Model.Statu == "tamamlandi" || Model.Statu == "Tamamlandi")
                                {
                                    <span class="badge bg-dark fs-6 mt-1">Tamamlandı</span>
                                }
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Yükleme Tarihi</small>
                                <span class="fw-bold fs-6 mt-1 d-block">@Model.YuklemeTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Staj Tarih Aralığı</small>
                                <span class="fw-bold fs-6 mt-1 d-block">
                                    @Model.StajBaslangicTarihi.ToString("dd.MM.yyyy") - @Model.StajBitisTarihi.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Haftalık Günler</small>
                                <span class="fw-bold fs-6 mt-1 d-block">
                                    @(string.IsNullOrWhiteSpace(Model.SecilenHaftalikGunler) ? "-" : Model.SecilenHaftalikGunler)
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="fw-semibold text-dark d-block">Yüklenen Belge: @Model.DosyaAdi</span>
                            <small class="text-muted">Uzantı: @Model.DosyaUzantisi</small>
                        </div>
                        <a href="@Model.DosyaYolu" target="_blank" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                            Dosyayı İndir / Aç
                        </a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.raporMesajı))
                    {
                        <div class="alert alert-warning mb-0" role="alert">
                            <strong>Yetkili Notu / Rapor:</strong> @Model.raporMesajı
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>