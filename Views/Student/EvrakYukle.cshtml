@model Lab3_proje.Models.ViewModels.EvrakYukleViewModel

@{
    ViewData["Title"] = "Ek-16 Staj Başvuru Formu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 900px;">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Ek-16 Staj Başvuru ve Kabul Formu</h2>
            <p class="text-secondary mb-0">Lütfen belgenizdeki bilgileri forma girin ve onaylı Ek-16 dosyasını yükleyin.</p>
        </div>
        <a href="/Student/Index" class="btn btn-outline-secondary rounded-pill px-3">
            ← Geri Dön
        </a>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

    <form id="evrakForm" asp-action="EvrakYukle" asp-controller="Student" method="post" enctype="multipart/form-data">

        <!-- 1. BÖLÜM: ÖĞRENCİ BİLGİLERİ (Ek-16 Belgesi) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">👤 1. Öğrenci Bilgileri (Ek-16 Üzerindeki Bilgileriniz)</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OgrenciAdiSoyadi" class="form-label fw-semibold">Ad Soyad</label>
                        <input asp-for="OgrenciAdiSoyadi" class="form-control form-control-lg rounded-3" placeholder="Örn: Ahmet Yılmaz" required />
                        <span asp-validation-for="OgrenciAdiSoyadi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TcKimlikNo" class="form-label fw-semibold">T.C. Kimlik No</label>
                        <input asp-for="TcKimlikNo" class="form-control form-control-lg rounded-3" maxlength="11" placeholder="11 haneli T.C. No" required />
                        <span asp-validation-for="TcKimlikNo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OgrenciNo" class="form-label fw-semibold">Öğrenci Numarası</label>
                        <input asp-for="OgrenciNo" class="form-control form-control-lg rounded-3" placeholder="Örn: 123456789" required />
                        <span asp-validation-for="OgrenciNo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Uyruk" class="form-label fw-semibold">Uyruk</label>
                        <select asp-for="Uyruk" class="form-select form-select-lg rounded-3">
                            <option value="T.C.">T.C.</option>
                            <option value="Yabancı">Yabancı</option>
                        </select>
                        <span asp-validation-for="Uyruk" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DogumTarihi" class="form-label fw-semibold">Doğum Tarihi</label>
                        <input asp-for="DogumTarihi" type="date" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="DogumTarihi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Bolum" class="form-label fw-semibold">Okuduğu Bölüm</label>
                        <input asp-for="Bolum" class="form-control form-control-lg rounded-3" placeholder="Örn: Bilgisayar Mühendisliği" />
                        <span asp-validation-for="Bolum" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Eposta" class="form-label fw-semibold">E-posta</label>
                        <input asp-for="Eposta" type="email" class="form-control form-control-lg rounded-3" placeholder="Örn: ogrenci@staj.edu.tr" />
                        <span asp-validation-for="Eposta" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TelefonNo" class="form-label fw-semibold">Telefon No</label>
                        <input asp-for="TelefonNo" class="form-control form-control-lg rounded-3" placeholder="Örn: 0555 123 45 67" />
                        <span asp-validation-for="TelefonNo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OncekiStajGunSayisi" class="form-label fw-semibold">Önceki Staj Gün Sayısı</label>
                        <input asp-for="OncekiStajGunSayisi" type="number" min="0" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="OncekiStajGunSayisi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SaglikYardimStatusu" class="form-label fw-semibold">Sağlık Yardımı Statüsü</label>
                        <select asp-for="SaglikYardimStatusu" class="form-select form-select-lg rounded-3">
                            <option value="Var">Var</option>
                            <option value="Yok">Yok</option>
                        </select>
                        <span asp-validation-for="SaglikYardimStatusu" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. BÖLÜM: STAJ YAPILACAK KURUM / ŞİRKET BİLGİLERİ -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">🏢 2. Staj Yapılacak Kurum / İş Yeri Bilgileri</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="KurumAdi" class="form-label fw-semibold">Kurum / Firma Adı</label>
                        <input asp-for="KurumAdi" class="form-control form-control-lg rounded-3" placeholder="Örn: ASELSAN A.Ş." required />
                        <span asp-validation-for="KurumAdi" class="text-danger small"></span>
                        <small class="text-muted">Ek-16 belgesinde kaşesi bulunan kurumun tam unvanını yazınız.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MuhendisSayisi" class="form-label fw-semibold">Kurumdaki Mühendis Sayısı</label>
                        <input asp-for="MuhendisSayisi" id="muhendisSayisiInput" type="number" min="1" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="MuhendisSayisi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6" id="mezuniyetKutusu">
                        <label asp-for="MuhendisMezuniyetBolumu" class="form-label fw-semibold">Mühendisin Mezun Olduğu Lisans Bölümü</label>
                        <input asp-for="MuhendisMezuniyetBolumu" id="mezuniyetInput" class="form-control form-control-lg rounded-3" placeholder="Örn: Bilgisayar Mühendisliği" />
                        <span asp-validation-for="MuhendisMezuniyetBolumu" class="text-danger small"></span>
                        <small class="text-warning fw-semibold d-block mt-1" id="muhendisUyariMetni">
                            ⚠️ Mühendis sayısı 5'in altında olduğu için lisans mezuniyet bölümü zorunludur!
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. BÖLÜM: STAJ TARİH VE DÖNEM BİLGİLERİ -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">📅 3. Staj Tarih ve Dönem Bilgileri</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OgretimYili" class="form-label fw-semibold">Öğretim Yılı</label>
                        <input asp-for="OgretimYili" class="form-control form-control-lg rounded-3" placeholder="Örn: 2025-2026" required />
                        <span asp-validation-for="OgretimYili" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Yariyil" class="form-label fw-semibold">Yarıyıl / Dönem</label>
                        <select asp-for="Yariyil" class="form-select form-select-lg rounded-3">
                            <option value="Bahar">Bahar</option>
                            <option value="Güz">Güz</option>
                            <option value="Yaz">Yaz</option>
                        </select>
                        <span asp-validation-for="Yariyil" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StajBaslangicTarihi" class="form-label fw-semibold">Staj Başlangıç Tarihi</label>
                        <input asp-for="StajBaslangicTarihi" type="date" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="StajBaslangicTarihi" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Stajdan en az 30 gün önce teslim edilmelidir.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StajBitisTarihi" class="form-label fw-semibold">Staj Bitiş Tarihi</label>
                        <input asp-for="StajBitisTarihi" type="date" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="StajBitisTarihi" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Resmi tatiller sistem tarafından otomatik düşülecektir.</small>
                    </div>

                    <div class="col-12 mt-3">
                        <label class="form-label fw-semibold d-block">Staj Yapılacak Haftalık Günler</label>
                        <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded-3">
                            @{
                                var gunler = new[] { "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi" };
                            }
                            @foreach (var gun in gunler)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SecilenGunler" value="@gun" id="gun_@gun" checked />
                                    <label class="form-check-label" for="gun_@gun">@gun</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. BÖLÜM: EK-16 EVRAK DOSYASI VE GOOGLE FORM -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">📄 4. Evrak Yükleme ve Teslimat</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="BelgeDosyasi" class="form-label fw-semibold">İmzalı Ek-16 Staj Belgesi (PDF veya Word)</label>
                        <input asp-for="BelgeDosyasi" type="file" class="form-control form-control-lg rounded-3" accept=".doc,.docx,.pdf,.jpeg,.jpg,.png" required />
                        <span asp-validation-for="BelgeDosyasi" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Desteklenen formatlar: .pdf, .docx, .doc, .jpeg, .png</small>
                    </div>

                    <div class="col-12">
                        <label asp-for="GoogleFormUrl" class="form-label fw-semibold">Staj Evrağı Teslim Google Form URL'si</label>
                        <input asp-for="GoogleFormUrl" id="googleFormUrlInput" class="form-control form-control-lg rounded-3" placeholder="https://forms.gle/... veya https://docs.google.com/forms/..." />
                        <span asp-validation-for="GoogleFormUrl" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Üniversitenin ilan ettiği teslim Google Form bağlantısını yapıştırınız.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gönder Butonu -->
        <div class="d-grid mb-5">
            <button type="submit" class="btn btn-success btn-lg rounded-3 py-3 fw-bold shadow" style="background-color: #10B981; border: none; font-size: 1.25rem;">
                🚀 Belgeyi Doğrula ve Staj Başvurusunu Tamamla
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const muhendisInput = document.getElementById('muhendisSayisiInput');
        const mezuniyetKutusu = document.getElementById('mezuniyetKutusu');
        const mezuniyetInput = document.getElementById('mezuniyetInput');
        const muhendisUyariMetni = document.getElementById('muhendisUyariMetni');

        function muhendisKontrol() {
            const sayi = parseInt(muhendisInput.value, 10);
            if (sayi < 5) {
                mezuniyetKutusu.style.display = 'block';
                muhendisUyariMetni.style.display = 'block';
                mezuniyetInput.required = true;
            } else {
                muhendisUyariMetni.style.display = 'none';
                mezuniyetInput.required = false;
            }
        }

        muhendisInput.addEventListener('input', muhendisKontrol);
        muhendisKontrol();

        document.getElementById('evrakForm').addEventListener('submit', function(e) {
            const formUrl = document.getElementById('googleFormUrlInput').value.trim();
            if (formUrl !== "") {
                const urlGecerli = formUrl.startsWith("http://") || formUrl.startsWith("https://");
                const googleFormMu = formUrl.includes("forms.gle") || formUrl.includes("docs.google.com/forms");

                if (!urlGecerli || !googleFormMu) {
                    e.preventDefault();
                    alert("⚠️ Geçersiz Google Form URL'si girdiniz! Lütfen geçerli bir Google Form linki giriniz (Örn: https://forms.gle/...).");
                }
            }
        });
    </script>
}