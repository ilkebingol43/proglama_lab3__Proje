@model Lab3_proje.Models.ViewModels.VeriSetiYukleViewModel

@{
    ViewData["Title"] = "Test Veri Seti Yükle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 800px;">

    <!-- Üst Başlık ve Geri Dön Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Öğrenci Test Veri Seti Yükle</h2>
            <p class="text-secondary mb-0">CSV dosyasındaki öğrencileri toplu olarak veritabanına aktarın.</p>
        </div>
        <a href="/Admin/Index" class="btn btn-outline-secondary fw-semibold">
            ← Başvurulara Dön
        </a>
    </div>

    <!-- Hata ve Bilgi Mesajları -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <!-- CSV Format Bilgilendirme Kutusu -->
    <div class="card border-0 shadow-sm rounded-4 bg-light mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-2">CSV Dosya Formatı Nasıl Olmalı?</h5>
            <p class="text-secondary small mb-3">
                Yükleyeceğiniz CSV dosyasının ilk satırı başlık olmalı ve her satır virgülle ayrılmış şu sütunları içermelidir:
            </p>
            <div class="bg-white p-3 rounded-3 border font-monospace small text-muted">
                Ad Soyad, TC Kimlik No, Uyruk, Öğrenci No, Bölüm, Telefon, E-posta<br />
                <span class="text-dark">Örn: Ahmet Yılmaz,12345678901,TC,210205001,Yazılım Mühendisliği,+90 555 123 45 67,ahmet@staj.edu.tr</span>
            </div>
            <small class="text-muted d-block mt-2">
                * Eklenen öğrencilerin varsayılan şifresi <code>Ogrenci123!</code> olarak oluşturulur.
            </small>
        </div>
    </div>

    <!-- Dosya Yükleme Kartı -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="VeriSetiYukle" asp-controller="Admin" method="post" enctype="multipart/form-data">
                
                <div class="mb-4">
                    <label asp-for="VeriDosyasi" class="form-label fw-semibold fs-6">CSV Dosyası Seçin</label>
                    <input asp-for="VeriDosyasi" type="file" accept=".csv" class="form-control form-control-lg rounded-3" />
                    <span asp-validation-for="VeriDosyasi" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg rounded-3 fw-semibold py-3 shadow-sm">
                        📥 Veri Setini İçe Aktar
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}