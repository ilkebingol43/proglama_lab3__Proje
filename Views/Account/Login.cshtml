@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/costumtheme.css" rel="stylesheet" />

<!-- Kayıt Ol Linki -->
<div style="position: fixed; top: 16px; right: 40px; z-index: 1050;">
    <a href="/Account/Register" class="text-decoration-none fw-bold fs-5" style="color: #10B981;">Kayıt Ol</a>
</div>

<!-- Ana İçerik Div'i -->
<div class="w-100 d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">
    
    <!-- Giriş Yap Başlığı -->
    <h1 class="fw-bold text-dark mb-xxl-5" style="font-size: 6rem;">Giriş Yap</h1>

    <!-- Butonları Yan Yana Dizen Kapsayıcı -->
    <div class="d-flex flex-column flex-md-row justify-content-center gap-lg-5 align-items-center mt-0">
        
        <!-- Öğrenci Girişi Butonu -->
        <a href="/Account/OgrenciLogin" class="btn-custom-gradient shadow-lg d-flex flex-column justify-content-center align-items-center" style="min-width: 350px; padding: 2rem;">
            <span style="font-size: 2.2rem; font-weight: bold;">Öğrenci Olarak</span>
        </a>

        <!-- Admin Girişi Butonu -->
        <a href="/Account/AdminLogin" class="btn-custom-gradient shadow-lg d-flex flex-column justify-content-center align-items-center" style="min-width: 350px; padding: 2rem;">
            <span style="font-size: 2.2rem; font-weight: bold;">Admin Olarak</span>
        </a>

    </div>
    
</div>