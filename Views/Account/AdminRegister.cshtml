@model Lab3_proje.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Admin Kayıt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/costumtheme.css" rel="stylesheet" />

<div style="position: fixed; top: 16px; right: 40px; z-index: 1050;">
    <a href="/Account/Login" class="text-decoration-none fw-bold fs-5" style="color: #10B981;">Giriş Yap</a>
</div>

<div class="w-100 d-flex flex-column justify-content-center align-items-center py-5" style="min-height: 80vh;">

    <h1 class="fw-bold text-dark mb-4" style="font-size: 4rem;">Admin Kaydı</h1>

    <div class="shadow-lg p-5 rounded-4 bg-white mb-5" style="min-width: 450px; max-width: 500px;">

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger text-center mb-4 rounded-3" role="alert">
                @ViewBag.Hata
            </div>
        }

        <form asp-action="AdminRegister" asp-controller="Account" method="post">

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold fs-6">Ad Soyad</label>
                <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="Örn: Mehmet Demir" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label fw-semibold fs-6">Kullanıcı Adı</label>
                <input asp-for="UserName" class="form-control form-control-lg rounded-3" placeholder="Kullanıcı adınızı belirleyin" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold fs-6">E-posta</label>
                <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="admin@staj.edu.tr" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold fs-6">Şifre</label>
                <input asp-for="Password" class="form-control form-control-lg rounded-3" placeholder="8-12 karakter, büyük harf ve özel karakter" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold fs-6">Şifre Tekrarı</label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg rounded-3" placeholder="Şifrenizi tekrar giriniz" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn-custom-gradient shadow-lg" style="font-size: 1.4rem; padding: 0.9rem;">
                    Kayıt Ol
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}